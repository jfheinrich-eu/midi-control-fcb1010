{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run UnO2 Language Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/vscode-uno2-language",
				"${workspaceFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/**/*.js"
			]
		}
	]
}
